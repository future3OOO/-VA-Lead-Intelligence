{
  "$defs": {
    "RunStatus": {
      "enum": [
        "pending",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "title": "RunStatus",
      "type": "string"
    }
  },
  "$id": "https://schemas.va-lead-intelligence/discovery_event-v1.0.0.schema.json",
  "additionalProperties": false,
  "description": "Tracked discovery request..",
  "properties": {
    "campaign_id": {
      "format": "uuid",
      "title": "Campaign Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "seed_url": {
      "format": "uri",
      "maxLength": 2083,
      "minLength": 1,
      "title": "Seed Url",
      "type": "string"
    },
    "source_id": {
      "title": "Source Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/RunStatus",
      "default": "pending"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "workspace_id": {
      "format": "uuid",
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "workspace_id",
    "campaign_id",
    "source_id",
    "seed_url"
  ],
  "title": "DiscoveryEvent",
  "type": "object",
  "version": "1.0.0"
}
