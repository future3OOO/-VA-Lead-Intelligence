{
  "$defs": {
    "LeadStatus": {
      "enum": [
        "pending",
        "accepted",
        "rejected",
        "suppressed",
        "exported"
      ],
      "title": "LeadStatus",
      "type": "string"
    }
  },
  "$id": "https://schemas.va-lead-intelligence/lead_assessment_create-v1.0.0.schema.json",
  "additionalProperties": false,
  "description": "Create request.",
  "properties": {
    "assessed_at": {
      "format": "date-time",
      "title": "Assessed At",
      "type": "string"
    },
    "campaign_id": {
      "format": "uuid",
      "title": "Campaign Id",
      "type": "string"
    },
    "company_id": {
      "format": "uuid",
      "title": "Company Id",
      "type": "string"
    },
    "reason_codes": {
      "items": {
        "type": "string"
      },
      "title": "Reason Codes",
      "type": "array"
    },
    "score": {
      "title": "Score",
      "type": "number"
    },
    "status": {
      "$ref": "#/$defs/LeadStatus",
      "default": "pending"
    },
    "workspace_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Workspace Id"
    }
  },
  "required": [
    "company_id",
    "campaign_id",
    "score",
    "assessed_at"
  ],
  "title": "LeadAssessmentCreate",
  "type": "object",
  "version": "1.0.0"
}
