    "access_policy_version": {
      "title": "Access Policy Version",
      "type": "string"
    },
    "body_excerpt": {
      "title": "Body Excerpt",
      "type": "string"
    },
    "company_domain_raw": {
      "title": "Company Domain Raw",
      "type": "string"
    },
    "company_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Company Id"
    },
    "company_name_raw": {
      "title": "Company Name Raw",
      "type": "string"
    },
    "contact_routes_raw": {
      "title": "Contact Routes Raw"
    },
    "content_hash": {
      "title": "Content Hash",
      "type": "string"
    },
    "intent_label": {
