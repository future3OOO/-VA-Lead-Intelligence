  "required": [
    "source_key",
    "source_native_id",
    "source_url",
    "observed_at",
    "published_at",
    "title",
    "body_excerpt",
    "company_name_raw",
    "company_domain_raw",
    "location_raw",
    "workplace_type",
    "content_hash",
