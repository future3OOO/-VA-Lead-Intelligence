{
  "$defs": {
    "IntentLabel": {
      "enum": [
        "buyer_request",
        "company_hiring",
        "operational_pain",
        "growth_trigger",
        "company_existence_only",
        "seller_promotion",
        "job_seeker",
        "general_discussion",
        "unresolved"
      ],
      "title": "IntentLabel",
      "type": "string"
    }
  },
  "$id": "https://schemas.va-lead-intelligence/source_hit_create-v1.0.0.schema.json",
  "additionalProperties": false,
  "description": "Create request.",
