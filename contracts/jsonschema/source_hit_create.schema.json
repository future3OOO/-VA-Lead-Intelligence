    "location_raw": {
      "title": "Location Raw",
      "type": "string"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "published_at": {
      "format": "date-time",
      "title": "Published At",
      "type": "string"
    },
    "raw_snapshot_uri": {
      "default": "",
      "title": "Raw Snapshot Uri",
      "type": "string"
    },
    "source_key": {
      "title": "Source Key",
      "type": "string"
    },
    "source_native_id": {
      "title": "Source Native Id",
      "type": "string"
    },
    "source_url": {
      "title": "Source Url",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "workplace_type": {
      "title": "Workplace Type",
      "type": "string"
    },
    "workspace_id": {
