{
  "$defs": {
    "OutcomeType": {
      "enum": [
        "contacted",
        "responded",
        "qualified",
        "converted",
        "uninterested",
        "bounced"
      ],
      "title": "OutcomeType",
      "type": "string"
    }
  },
  "$id": "https://schemas.va-lead-intelligence/outcome_create-v1.0.0.schema.json",
  "additionalProperties": false,
  "description": "Create request.",
  "properties": {
    "lead_id": {
      "format": "uuid",
      "title": "Lead Id",
      "type": "string"
    },
    "notes": {
      "title": "Notes",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "outcome_type": {
      "$ref": "#/$defs/OutcomeType"
    },
    "workspace_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Workspace Id"
    }
  },
  "required": [
    "lead_id",
    "outcome_type",
    "occurred_at",
    "notes"
  ],
  "title": "OutcomeCreate",
  "type": "object",
  "version": "1.0.0"
}
