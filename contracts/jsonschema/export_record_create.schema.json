      "type": "string"
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    },
    "destination": {
      "title": "Destination",
      "type": "string"
    },
    "lead_ids": {
      "items": {
        "type": "string"
      },
      "title": "Lead Ids",
