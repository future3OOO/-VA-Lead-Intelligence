{
  "$id": "https://schemas.va-lead-intelligence/discovery-v1.0.0.schema.json",
  "additionalProperties": false,
  "description": "Initial discovery request for a seed.",
  "properties": {
    "campaign_id": {
      "format": "uuid",
      "title": "Campaign Id",
      "type": "string"
    },
    "correlation_id": {
      "format": "uuid",
      "title": "Correlation Id",
      "type": "string"
    },
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "producer": {
      "title": "Producer",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "seed_url": {
      "format": "uri",
      "maxLength": 2083,
      "minLength": 1,
      "title": "Seed Url",
      "type": "string"
    },
    "source_id": {
      "title": "Source Id",
      "type": "string"
    },
    "workspace_id": {
      "format": "uuid",
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "occurred_at",
    "workspace_id",
    "correlation_id",
    "producer",
    "seed_url",
    "source_id",
    "campaign_id"
  ],
  "title": "Discovery",
  "type": "object",
  "version": "1.0.0"
}
