{
  "$id": "https://schemas.va-lead-intelligence/crawl_request-v1.0.0.schema.json",
  "additionalProperties": false,
  "description": "Request to crawl a single URL.",
  "properties": {
    "browser_allowed": {
      "default": false,
      "title": "Browser Allowed",
      "type": "boolean"
    },
    "correlation_id": {
      "format": "uuid",
      "title": "Correlation Id",
      "type": "string"
    },
    "crawl_depth": {
      "default": 0,
      "title": "Crawl Depth",
      "type": "integer"
    },
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "producer": {
      "title": "Producer",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "url": {
      "format": "uri",
      "maxLength": 2083,
      "minLength": 1,
      "title": "Url",
      "type": "string"
    },
    "workspace_id": {
      "format": "uuid",
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "occurred_at",
    "workspace_id",
    "correlation_id",
    "producer",
    "url"
  ],
  "title": "CrawlRequest",
  "type": "object",
  "version": "1.0.0"
}
